{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ListingAuditResult",
  "description": "Schema for a single listing audit result from the Listing Audit Worker POC",
  "type": "object",
  "required": [
    "listing_id",
    "platform",
    "overall_score",
    "title_quality",
    "description_quality",
    "image_quality",
    "pricing_risk",
    "action_recommendation"
  ],
  "properties": {
    "listing_id": {
      "type": "string",
      "description": "Unique identifier for the listing, matching the input sample"
    },
    "platform": {
      "type": "string",
      "enum": ["mercari", "rakuten", "amazon"],
      "description": "Target ecommerce platform"
    },
    "overall_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Overall listing quality score (0-100)"
    },
    "title_quality": {
      "type": "object",
      "required": ["score", "issues", "suggested_title"],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Title quality score (0-100)"
        },
        "issues": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of issues found with the title"
        },
        "suggested_title": {
          "type": "string",
          "description": "Suggested improved title (Japanese if input is Japanese)"
        }
      }
    },
    "description_quality": {
      "type": "object",
      "required": ["score", "issues", "suggested_description"],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Description quality score (0-100)"
        },
        "issues": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of issues found with the description"
        },
        "suggested_description": {
          "type": "string",
          "description": "Suggested improved description (Japanese if input is Japanese)"
        }
      }
    },
    "image_quality": {
      "type": "object",
      "required": ["score", "issues"],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Image quality score (0-100)"
        },
        "issues": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of issues found with images"
        }
      }
    },
    "pricing_risk": {
      "type": "object",
      "required": ["level", "reason"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "Pricing risk level"
        },
        "reason": {
          "type": "string",
          "description": "Explanation of pricing risk assessment"
        }
      }
    },
    "action_recommendation": {
      "type": "object",
      "required": ["type", "priority", "reason"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["no_action", "rewrite", "manual_review", "price_check", "image_fix"],
          "description": "Recommended action type"
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "Action priority"
        },
        "reason": {
          "type": "string",
          "description": "Reason for the recommendation"
        }
      }
    }
  }
}
