# Supabase local development
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace_with_local_service_role_key
INTERNAL_CATALOG_API_TOKEN=replace_with_a_dedicated_internal_bearer_token
ORDERMGMT_CATALOG_API_TOKEN=replace_with_a_dedicated_ordermgmt_owner_bearer_token
INTERNAL_CATALOG_API_URL=http://127.0.0.1:8788/api/internal/catalog

# Local listing-copy improvement loop (fail-closed defaults)
COPY_IMPROVEMENT_ENABLED=false
COPY_APPLY_MODE=dry_run
COPY_IMPROVEMENT_AUTO_SHOPS=
COPY_IMPROVEMENT_CONFIDENCE_THRESHOLD=0.85
LISTING_COPY_PROVIDER=deepseek
LISTING_COPY_MODEL=deepseek-chat
LISTING_IMAGE_MODEL=qwen3.5:9b
LISTING_QWEN_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LISTING_DEEPSEEK_TIMEOUT_MS=120000
LISTING_DEEPSEEK_MAX_TOKENS=1800
COPY_BENCHMARK_TTL_DAYS=30
COPY_BENCHMARK_CAPTURE_DELAY_MS=1000
COPY_LIVE_MIN_OPPORTUNITY_SCORE=35
COPY_LIVE_CONFIDENCE_THRESHOLD=0.90
COPY_LIVE_MIN_COMMERCIAL_DELTA=10
COPY_LIVE_COOLDOWN_DAYS=7
INTERNAL_CATALOG_API_URL=https://rpagentos.pages.dev/api/internal/catalog
INTERNAL_CATALOG_API_TOKEN=

# Agent OS default target
AGENT_OS_TARGET_PLATFORM=mercari
AGENT_OS_TARGET_SHOP=shop4
